# 评测素材（近 1GB，外部下载，不进版本库）
eval/*.mp4
eval/*.part
eval/*.webm
eval/*.mkv

# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# 中间产物
.tmp/
*.log
sheets/*.png

# 系统
.DS_Store
Thumbs.db
legacy/

# Python 打包产物（pip install . / python -m build 会生成）
build/
dist/
*.egg-info/
*.egg

# 测试/演示的输出目录（GUI 默认把产物写到素材旁边，容易落在 eval/ 下）
eval/shots/
eval/shots-*/

# e2e 测试的依赖与产物（puppeteer-core 是测试专用，不进产品）
tests/e2e/node_modules/
tests/e2e/package-lock.json

# e2e 单实例锁
eval/.e2e.lock

# 任务队列（运行时状态，不进版本库）
.kf-queue.db
.kf-queue.db-journal
.kf-queue.db-wal
